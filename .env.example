# Connection string for the local PostgreSQL database started with `docker compose up -d`.
# These are development-only credentials that match docker-compose.yml exactly — they only
# work against the local Docker container on your own machine, so it's safe to keep them
# here as a working example. In a real deployment, credentials like these must NEVER be
# committed to a repository; they would come from a secrets manager or CI/CD environment
# variables instead.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/inventory?schema=public"

# Port the API listens on. Optional — defaults to 3000 if not set.
PORT=3000
